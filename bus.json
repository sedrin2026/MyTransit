function getUpcomingBuses(selectedStop, busData) {
  // 1. 現在時刻を HH:mm 形式で取得
  const now = new Date();
  const currentHH = String(now.getHours()).padStart(2, '0');
  const currentMM = String(now.getMinutes()).padStart(2, '0');
  const currentTime = `${currentHH}:${currentMM}`;

  // 2. 選択されたバス停を出発地(from)とし、現在時刻以降の便に絞り込み
  const filtered = busData.filter(item => {
    return item.from === selectedStop && item.departure >= currentTime;
  });

  // 3. 発車時刻順にソートして直近3便を取得
  filtered.sort((a, b) => a.departure.localeCompare(b.departure));
  return filtered.slice(0, 3);
}

// 使用例
// 「三軒屋」を選択した場合 -> 「三軒屋 ➔ 次郎丸」の直近3便
const nextBusesFromSangenya = getUpcomingBuses("三軒屋", busData);

// 「次郎丸」を選択した場合 -> 「次郎丸 ➔ 三軒屋」の直近3便
const nextBusesFromJiroMaru = getUpcomingBuses("次郎丸", busData);
